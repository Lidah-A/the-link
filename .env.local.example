# Example environment variables for local development and Vercel deployment
# Copy this to .env.local (DO NOT commit .env.local with real secrets)

# Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client) — safe to expose to browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: mock user for local development (only used by the local mock client)
NEXT_PUBLIC_SUPABASE_MOCK_USER_EMAIL=

# Storage bucket name (matches what you create in Supabase)
SUPABASE_STORAGE_BUCKET=request-attachments
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=request-attachments

# SendGrid (optional)
SENDGRID_API_KEY=
TEAM_NOTIFICATION_EMAIL=
NOTIFICATION_FROM_EMAIL=

# Admin list (comma-separated) used by server admin checks
ADMIN_EMAILS=

# Notes:
# - Keep SUPABASE_SERVICE_ROLE_KEY secret and do NOT prefix it with NEXT_PUBLIC_.
# - Add these to Vercel (Production and Preview) under Settings → Environment Variables.
# - For local dev, copy this file to .env.local and fill values.
# Copy to .env.local and fill values before running the dev server
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alternatively, for less-privileged server usage you can set SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=your-anon-key
SENDGRID_API_KEY=your-sendgrid-api-key
TEAM_NOTIFICATION_EMAIL=team@example.com
NOTIFICATION_FROM_EMAIL=notifications@example.com
# Public keys for client usage (expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated admin emails allowed to access /admin
ADMIN_EMAILS=admin1@example.com,admin2@example.com
SUPABASE_STORAGE_BUCKET=request-attachments
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=request-attachments
